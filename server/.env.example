# ------------------------------------------------------------------
# Que-swer server environment (copy to server/.env — never commit)
# ------------------------------------------------------------------

# PostgreSQL connection (local dev default; use your managed DB for prod)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/que_swer?schema=public"

# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Auth secrets — generate strong random values, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"       # short-lived access token
JWT_REFRESH_TTL="30d"      # refresh token lifetime
COOKIE_SECURE="false"      # set true in production (HTTPS)

# Rate limits
RATE_LIMIT_AUTH="100"      # requests / 15 min per IP for auth routes
RATE_LIMIT_WRITE="200"     # requests / 15 min per IP for write routes

# Logging
LOG_LEVEL="info"

# Paper upload storage (dev: local disk under server/storage; prod: S3-compatible)
STORAGE_DRIVER="local"     # local | s3
STORAGE_PATH="./storage/papers"
# S3 (used only when STORAGE_DRIVER=s3)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
PUBLIC_BASE_URL="http://localhost:4000"
