{
  "name": "que-swer",
  "version": "0.1.0",
  "private": true,
  "description": "NEHU Questions & Answers platform with previous-year paper library (PERN monorepo)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "test": "npm run test --workspace=server",
    "lint": "npm run lint --workspace=server && npm run lint --workspace=client",
    "format": "prettier --write .",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "db:import": "npm run db:import --workspace=server"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,css,html,json,md}": [
      "prettier --write"
    ]
  }
}
